{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noPropertyAccessFromIndexSignature": false,
		"jsx": "react-jsx",
		"paths": {
			"@electron/*": ["./src/*"],
			"@fluxer/win-shell": ["./native/win-shell/index.d.ts"],
			"@fluxer/game_catalog/*": ["../packages/game_catalog/*"],
			"@fluxer/voice_engine_v2": ["../packages/voice_engine_v2/src/index.ts"],
			"@fluxer/voice_engine_v2/*": ["../packages/voice_engine_v2/*"],
			"@fluxer/*": ["../packages/*", "../packages/*/src/index.ts"]
		}
	},
	"include": [
		"src/**/*",
		"../packages/desktop_ipc/src/**/*",
		"../packages/game_catalog/src/**/*",
		"../packages/voice_engine_v2/src/**/*"
	],
	"exclude": ["node_modules", "dist"]
}
